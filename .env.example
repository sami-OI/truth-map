# ─────────────────────────────────────────────────────────────────
# TRUTH MAP API — Environment variables
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Your PostgreSQL connection ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=your_database_name

# Set to true if your DB is on AWS RDS, Supabase, or any cloud host
POSTGRES_SSL=false

# ── Server settings ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS — which websites are allowed to call this API ────────────
# Development: * means anyone (fine for local testing)
# Production: set to your exact Webflow URL, e.g.:
#   CORS_ORIGIN=https://yourcompany.webflow.io
CORS_ORIGIN=*

# Key the NestJS API (src/) expects in the x-api-key header
TRUTH_MAP_API_KEY=

# ── Truth Map dashboard (truth-map-world.html) → v1 API ──────────
# Run `npm run dashboard:config` to write truth-map-config.js from these
DASHBOARD_API_BASE=https://your-api-host/api/v1/truth-map
DASHBOARD_API_KEY=
DASHBOARD_API_KEY_HEADER=api-key
# live | auto (sample data if API unreachable) | sample
DASHBOARD_DATA_MODE=live
# Course opened first when you click into a country (matched by title)
DASHBOARD_DEFAULT_COURSE=OIAI AI Literacy Skills
# Admin mode PIN (Admin button in the dashboard). Empty = admin mode disabled.
DASHBOARD_ADMIN_PIN=
# Hidden tabs / charts / numbers for everyone. Produced by Admin mode → "Save for everyone".
DASHBOARD_HIDDEN=
# Assessment scores server, if different from DASHBOARD_API_BASE (empty = same)
DASHBOARD_ASSESSMENT_API_BASE=
# jsDelivr hosting: public GitHub repo (org/name) and release tag
DASHBOARD_CDN_REPO=
DASHBOARD_CDN_VERSION=v1.0.0
