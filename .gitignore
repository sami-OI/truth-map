# ── Secrets: never commit ─────────────────────────────────────────
.env
.env.*
!.env.example
# generated from .env, contains the API key + admin PIN
truth-map-config.js
# hand-off package + Webflow embed snippet, contain the API key
handoff/

# ── Dependencies and build output ─────────────────────────────────
node_modules/
dist/
coverage/
*.tsbuildinfo
# NOTE: cdn/ is committed on purpose. jsDelivr serves cdn/truth-map.js from this repo.

# ── Logs and OS / editor files ────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Internal documents (SOP etc.) are never published
*.docx
~$*.docx

# ── Database cleaning: never commit real data ─────────────────────
# database dumps / backups and run output (db-cleaning/sql/*.sql are the scripts, kept)
*.dump
*.backup
*_before_*.sql
backups/
dry-run*.txt
# exported API data used to seed dev (real learner counts)
pairs.json
*.zip
